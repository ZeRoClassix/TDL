    "naming": "Use a single 'name' field for the player display name. The 'aliases' array handles alternate spellings/tags.",
    "removeRecords_howTo": [
      "To REMOVE specific records from a player, add a 'removeRecords' array with the level names to remove.",
      "This keeps all of the player's auto-computed data but filters out the specified levels.",
      "The player's total score is automatically recalculated after removal.",
      "You can also combine removeRecords with name/flag/rank overrides.",
      "",
      "Example — Remove 'Acheron' and 'Slaughterhouse' from a player named 'SomePlayer':",
      "{",
      "  \"someplayer\": {",
      "    \"enabled\": true,",
      "    \"name\": \"SomePlayer\",",
      "    \"removeRecords\": [\"Acheron\", \"Slaughterhouse\"]",
      "  }",
      "}",
      "",
      "You can also change the player's name/flag while removing records:",
      "{",
      "  \"someplayer\": {",
      "    \"enabled\": true,",
      "    \"name\": \"SomePlayer\",",
      "    \"countryFlag\": \"us\",",
      "    \"removeRecords\": [\"Acheron\"]",
      "  }",
      "}"
    ]
  },
